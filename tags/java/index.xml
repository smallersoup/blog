&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="c1"&gt;//super(33,&amp;#34;Hello&amp;#34;);//构造函数调用必须声明在构造函数中,这行代码不注释的话会报错&lt;/span&gt;&lt;span class="w"&gt;
